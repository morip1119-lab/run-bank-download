# LINE Developers / Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# コマンドを実行できるユーザー（LINE の userId。下の LOG で確認するまで仮で ok）
ALLOWED_LINE_USER_ID=

# 1 にすると、POST /callback の JSON と source.userId をターミナルに出す（調査用）
# LOG_WEBHOOK_EVENTS=1

# 任意（既定: 3000）
PORT=3000

# SQLite DB パス（既定: data/app.db）
# SQLITE_PATH=data/app.db

# Google OAuth（npm run google-auth 後に token.json ができる）
# GOOGLE_CLIENT_SECRET_PATH=client_secret.json
# GOOGLE_TOKEN_PATH=token.json

# カレンダーのタイムゾーン（既定: Asia/Tokyo）
# CALENDAR_TIMEZONE=Asia/Tokyo

# 会議の長さ（分、既定: 60）
# DEFAULT_DURATION_MINUTES=60

# 「修正」だけ送ったあと、次の指示を待つ時間（分）
# CORRECTION_WAIT_MINUTES=15

# ── 入金管理 ダッシュボード認証 ──
# アクセス時に入力するパスワード（アカウントごとに別々に設定）
PAYMENT_BURIZUMU_PASSWORD=
PAYMENT_TRYNNOX_PASSWORD=

# ── 入金管理 / MoneyForward ME 自動取得 ──
MONEYFORWARD_EMAIL=
MONEYFORWARD_PASSWORD=
# セッションCookie保存先（省略時: data/mf_session.json）
# MF_SESSION_PATH=data/mf_session.json
# MFグループ名（マネーフォワードのグループドロップダウンに表示される名前と完全一致）
# MF_GROUP_BURIZUMU=BURIZUMU
# MF_GROUP_TRYNNOX=Trynnox

# ── 個人支出管理 ──
# MoneyForwardの個人用グループ名（「個人用」など。空欄=全取引）
# MF_PERSONAL_GROUP=個人用
# 支出同期・予算アラートの通知先 LINE userId（ALLOWED_LINE_USER_ID と同じでOK）
# EXPENSE_LINE_USER_ID=

# ── Misoca（複数アカウント） ──
# MISOCA_CLIENT_ID=
# MISOCA_CLIENT_SECRET=
# MISOCA_BURIZUMU_ACCESS_TOKEN=
# MISOCA_BURIZUMU_REFRESH_TOKEN=
# MISOCA_TRYNNOX_ACCESS_TOKEN=
# MISOCA_TRYNNOX_REFRESH_TOKEN=

# ── 受信請求書の自動処理 ──
# 支払い管理スプレッドシートのID（URL の /d/XXXX/edit の XXXX 部分）
PAYMENT_SHEET_ID=17P1cKSdSmHQV_eSKGvFbktBWvWEjVXoj1ENgfEVumVc
# 受信請求書 PDF のアップロード先 Google Drive フォルダID
KEIRI_DRIVE_FOLDER_ID=1zFTeHYifjOMkB9hcqg0Evl858Yj7sO1O
# 処理完了時の通知先 Chatwork ルームID（任意）
# INVOICE_NOTIFY_ROOM_ID=

# ── 住信SBIネット銀行 入出金明細 CSV 自動ダウンロード ──
# ログインID（契約者番号）
SUMISHIN_SBI_LOGIN_ID=
# ログインパスワード
SUMISHIN_SBI_PASSWORD=
# CSV保存フォルダ（省略時: downloads）
# SUMISHIN_DOWNLOAD_DIR=downloads
# 1 にするとブラウザ非表示で実行（省略時: 0 = ブラウザ表示あり）
# SUMISHIN_HEADLESS=0

# ── IMAP 設定（keiri@misokoji.com の受信メールサーバー） ──
# エックスサーバーの場合: sv〇〇〇〇〇.xserver.jp または mail.misokoji.com
IMAP_HOST=sv00000.xserver.jp
# SSL/TLS ポート（通常 993。変更不要のケースが多い）
IMAP_PORT=993
# メールアドレス（ログインユーザー名）
IMAP_USER=keiri@misokoji.com
# メールパスワード
IMAP_PASS=
